# Example only. The real file is secrets/android/signing.env (never committed).
# "10 Build Android App.bat" creates it the first time you build a release, by asking you.
ORG_NAME="My Studio"
BUNDLE_PREFIX="com.mystudio"          # bundle ids become com.mystudio.<game>
KEYSTORE="mystudio.keystore"          # file in secrets/android/, or the full path of a keystore you already use
KEY_ALIAS="mystudio"
STORE_PASS="choose-a-password"
KEY_PASS="choose-a-password"
