# Usage limits: what each provider allows, so scripts/usage.py can show what's left.
# Like models.env these are dated decisions, not live readings. Fix a line when a plan or limit changes.
# Empty = no known limit (the report then shows usage and the last time a limit was hit).
# Claude and Antigravity % are read live (clanker-usage). Only providers that can be read automatically are listed.

# Claude Pro (the lead). Two clocks: a 5-hour session window and a weekly limit, shared by the app and Claude Code.
# Read live with Claude Code's login in Ubuntu. decided 2026-11-02
CLAUDE_PLAN="Pro"
CLAUDE_WEEK_RESET=""          # only used when the live read fails: e.g. "Thu 21:00" from Settings > Usage
# Optional: your own token budget for Claude Code (autopilot, Claude Code - Open) per 5-hour window.
# Leave empty at first. After the first "limit reached", the report shows how many tokens that window
# had used: put that number here and it becomes your gauge.
CLAUDE_CODE_TOKENS_5H=""

# opencode Zen free models (GLM, DeepSeek). No published limit; they rate-limit when busy.
# Optional own budgets (jobs per day) so you can see when you're leaning on one too hard.
OPENCODE_FREE_JOBS_DAY=""
OPENCODE_FREE2_JOBS_DAY=""

# Antigravity (Gemini) free tier: weekly agent quota, size not published. Its % is read live; relay jobs are counted too.
AGY_JOBS_WEEK=""              # optional own budget
# NVIDIA build free endpoints: rate-limited per minute, no daily cap published. Optional own budgets (jobs per day).
NVIDIA_JOBS_DAY=""
NVIDIA2_JOBS_DAY=""

# OpenRouter free models (through PAL). Read live from openrouter.ai when OPENROUTER_API_KEY is set.
# Last known: 20 a minute, 50 a day (1,000 a day once 10 USD of credits were ever bought). UTC day.
OPENROUTER_FREE_DAY="50"

# Codex: off until a ChatGPT plan is added.
CODEX_PLAN=""

# Google Flow is not tracked: its credits can't be read automatically (costs per clip: stacks/video.md).

# Warn when less than this % is left.
LOW_PCT="20"
