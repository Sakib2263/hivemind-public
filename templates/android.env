# Android app facts for Hivemind builds. Copy into the project root as android.env (no secrets here).
# The build asks for anything missing; Claude asks you before sending an android job.
APP_NAME="My Game"                 # shown under the icon, max 30 characters
APP_ID="com.yourstudio.mygame"      # bundle id / package name. Can NEVER change after the first Play upload
ICON="store/icon-1024.png"         # square PNG, 1024x1024, path inside the project. Required for release
ORIENTATION="portrait"             # portrait | landscape | any
VERSION_NAME="1.0.0"               # what players see
VERSION_CODE=1                     # goes up by 1 for every Play upload (the release build does this for you)
# Optional: WEB_DIR="dist" (Node projects, default dist), WEB_ENTRY="My Game.html" (single-file games)
