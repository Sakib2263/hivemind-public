# Keep the computer awake while Hivemind works (windows\keep-awake.ps1, mac-linux/keep-awake.sh).
# Awake = the relay is running AND a job is queued or running, autopilot is running, or the last job ended less than
# AWAKE_GRACE_MINUTES ago (Claude is reading the result and sending the next one). Otherwise the computer may sleep
# as usual. The keeper stops by itself 10 minutes after the relay closes. decided 2026-11-04
KEEP_AWAKE="yes"            # no = never hold the computer awake
AWAKE_GRACE_MINUTES="15"    # how long after the last job to stay awake
AWAKE_DISPLAY="no"          # yes = keep the screen on too (default: only stop sleep; the screen may turn off)
