# Extra folders where your projects may live, besides the work folder that holds Hivemind.
# The relay only works inside the work folder and these. Separate them with ";". Windows paths are fine.
# Example: WORK_FOLDERS="E:\Games;D:\Clients\Acme"
WORK_FOLDERS=""

# Shared asset library for every game (downloaded packs, filed by type, with INDEX.md). Empty = <work folder>\Games\_Assets
ASSET_LIBRARY=""
