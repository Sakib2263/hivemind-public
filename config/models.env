# Models register: which model each relay worker calls.
# These are decisions with a date, not live readings. Update a line when a provider renames
# a model, and move the old name to "retired". The relay reads this file on every job.

# Codex: used whenever it's logged in with any ChatGPT account (free included) and has quota. Empty = the account default.
# decided 2026-10-28
CODEX_MODEL=""
CODEX_EFFORT_DEFAULT="medium"          # none | low | medium | high | xhigh | max

# Antigravity (Gemini). Empty = Antigravity default (Flash). Hard jobs: send "model: hard".
# decided 2026-10-25
AGY_MODEL_HARD="Gemini 3.1 Pro (High)"

# DeepSeek through opencode (relay worker "deepseek"). Source: api-docs.deepseek.com
# OFF FOR NOW: pay-per-use API. Turns on only when DEEPSEEK_API_KEY is added later.
# decided 2026-10-28. Retired, never use: deepseek-chat. Legacy alias, don't write: deepseek-v4-flash
DEEPSEEK_MODEL="deepseek/deepseek-flash"
DEEPSEEK_MODEL_HARD="deepseek/deepseek-v4-pro"

# OpenRouter free models (through PAL, not the relay). Recheck names before each project.
# decided 2026-10-25. Never for client or NDA work.
OPENROUTER_FREE_CODE="poolside/laguna-s-2.1:free"
OPENROUTER_FREE_BULK="nvidia/nemotron-3.5-lightning:free"

# opencode: OpenCode Zen free models (logged in with an OpenCode key, no other keys). decided 2026-10-29
# Both below are free for a limited time, zero data retention, not used for training (OpenCode docs).
# Free periods end: if a model stops working, run "opencode models opencode" and pick a new "-free" id.
# Avoid the Big Pickle, Flint, MiMo and Nemotron free models on Zen for real work: they keep or train on data.
OPENCODE_FREE_MODEL="opencode/glm-5.3-flash-free"         # main builder (coding)
OPENCODE_FREE2_MODEL="opencode/deepseek-v4.1-flash-free"  # second builder, mechanical work, backup on limits
# NVIDIA build (build.nvidia.com): free endpoints with an NVIDIA_API_KEY (optional), through opencode's "nvidia"
# provider. Rate-limited per minute, no daily cap published; never for client or NDA work. Ids are opencode ids:
# nvidia/<id from build.nvidia.com>. Check they still exist: 5 Check Everything (or providers.py nvidia-check).
# Picked for vendor variety next to GLM and DeepSeek, so they also work as cross-vendor reviewers. decided 2026-11-03
NVIDIA_MODEL="nvidia/minimaxai/minimax-m3.1-flash"            # nv: coding and agentic builder (MiniMax)
NVIDIA_MODEL2="nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b"  # nv2: reasoning, reviews, reading (NVIDIA Nemotron)
# Later, when paid plans or keys are added (leave empty until then):
OPENCODE_COPILOT_MODEL=""   # github-copilot/<model>, needs a GitHub Copilot plan
OPENCODE_GEMINI_MODEL=""    # google/<model>, needs a Google AI Studio API key

# Checks and reviews: which engines run them, tried in order (next one on limits).
# Cross-vendor: opencode (GLM/DeepSeek) builds, so Antigravity (Gemini) reviews first, then NVIDIA's MiniMax.
# Codex is in both as a later engine; move it earlier if you add a paid plan.
GATE_ENGINES="opencode:free opencode:free2 opencode:nv agy codex"
REVIEW_ENGINES="agy opencode:nv codex opencode:nv2 opencode:free2 opencode:free"

# Autopilot: Claude model for unattended row work (Opus isn't needed for settled rows). decided 2026-11-02
AUTOPILOT_MODEL="sonnet"

# Stalls and skips (relay). A free model with no new output and no file change for OPENCODE_IDLE_SECONDS is stopped
# and the next one tries. A model that hit a limit or stalled in the last SKIP_STUCK_MINUTES is skipped (never the last
# one in a chain). decided 2026-11-02
OPENCODE_IDLE_SECONDS="360"
SKIP_STUCK_MINUTES="60"
SKIP_STUCK_MINUTES_NVIDIA="5"   # NVIDIA limits are per minute: try it again soon

# Automatic fallback chains: when a worker hits a limit or is unavailable, the relay tries these next.
# Order = priority: free unlimited-ish first (Zen), then NVIDIA (per-minute limits), then the weekly quotas
# (Antigravity is kept for reviews), then paid. A provider with no key or login fails in seconds and is skipped.
# A chain may list the job's own model: it is tried once only. Rules and reasons: templates/routing/models.md
FALLBACK_opencode="opencode:free opencode:free2 opencode:nv opencode:nv2 agy codex deepseek"
FALLBACK_agy="agy:hard opencode:nv2 opencode:free codex"
FALLBACK_codex="opencode:free opencode:free2 opencode:nv"
FALLBACK_codex_review="review"
FALLBACK_deepseek="opencode:free2 opencode:free opencode:nv"
